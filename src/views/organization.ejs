
<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <section class="organization-details">
        <h2><%= organizationDetails.name %></h2>

        <img
            src="/images/<%= organizationDetails.logo_filename %>"
            alt="<%= organizationDetails.name %> logo"
        >

        <p>
            <strong>Description:</strong>
            <%= organizationDetails.description %>
        </p>

        <p>
            <strong>Contact Email:</strong>
            <a href="mailto:<%= organizationDetails.contact_email %>">
                <%= organizationDetails.contact_email %>
            </a>
        </p>

        <h3>Service Projects by This Organization</h3>

        <% if (projects && projects.length > 0) { %>
            <ul>
                <% projects.forEach(project => { %>
                    <li>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title || project.name %>
                        </a>

                        <% if (project.location) { %>
                            - <%= project.location %>
                        <% } %>
                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <p>This organization has no service projects currently listed.</p>
        <% } %>
    </section>
</main>

<%- include('partials/footer') %>
