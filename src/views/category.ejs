
<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <section class="category-details">
        <h2><%= category.name %></h2>

        <h3>Service Projects in This Category</h3>

        <% if (projects && projects.length > 0) { %>
            <ul>
                <% projects.forEach(project => { %>
                    <li>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <p>No service projects are currently available in this category.</p>
        <% } %>
    </section>
</main>

<%- include('partials/footer') %>
