
<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <section class="project-details">
        <h2><%= project.title %></h2>

        <p>
            <strong>Description:</strong>
            <%= project.description %>
        </p>

        <p>
            <strong>Date:</strong>
            <%= new Date(project.date).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                timeZone: 'UTC'
            }) %>
        </p>

        <p>
            <strong>Location:</strong>
            <%= project.location %>
        </p>

        <p>
            <strong>Partner Organization:</strong>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>

        <div class="project-categories">
            <h3>Categories</h3>

            <% if (categories && categories.length > 0) { %>
                <ul>
                    <% categories.forEach(category => { %>
                        <li>
                            <a href="/category/<%= category.category_id %>">
                                <%= category.name %>
                            </a>
                        </li>
                    <% }) %>
                </ul>
            <% } else { %>
                <p>No categories assigned to this project.</p>
            <% } %>
        </div>

        <p>
            <a href="/project/<%= project.project_id %>/assign-categories">
                Assign Categories
            </a>
        </p>
    </section>
</main>

<%- include('partials/footer') %>
