
<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <section class="project-details">
        <h2><%= project.name %></h2>

        <p>
            <strong>Description:</strong>
            <%= project.description %>
        </p>

        <p>
            <strong>Date:</strong>
            <%= new Date(project.project_date).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                timeZone: 'UTC'
            }) %>
        </p>

        <p>
            <strong>Location:</strong>
            <%= project.location %>
        </p>

        <p>
            <strong>Partner Organization:</strong>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>

        <div class="project-categories">
            <h3>Category</h3>

            <% if (categories && categories.length > 0) { %>
                <% categories.forEach(category => { %>
                    <p>
                        <a href="/category/<%= category.category_id %>">
                            <%= category.name %>
                        </a>
                    </p>
                <% }); %>
            <% } else { %>
                <p>No category assigned to this project.</p>
            <% } %>
        </div>

        <p>
            <a href="/edit-project/<%= project.project_id %>">
                Edit Project
            </a>
        </p>

        <p>
            <a href="/project/<%= project.project_id %>/assign-categories">
                Change Project Category
            </a>
        </p>
    </section>
</main>

<%- include('partials/footer') %>
